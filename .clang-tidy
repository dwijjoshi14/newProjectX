# Two checks are off on purpose, and the reasons live here rather than inside
# the Checks block, because text inside a folded scalar becomes part of the
# check list and silently disables nothing.
#
# bugprone-easily-swappable-parameters: phase quantities are the same physical
# type by design, and a swapped pair is caught by the Clarke round trip and the
# sign convention tests, not by the type system.
#
# performance-enum-size: wants a fixed enum underlying type, which is C23 or C++
# only. A C11 header cannot express it, so the check cannot be satisfied.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  -performance-enum-size,
  readability-braces-around-statements,
  readability-const-return-type,
  readability-misleading-indentation,
  readability-non-const-parameter,
  readability-redundant-*
WarningsAsErrors: '*'
HeaderFilterRegex: '(firmware|sim|harness)/.*'
FormatStyle: file
